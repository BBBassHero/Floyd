// 系统时钟
IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// 复位输入（板载按键，低有效，内部上拉）
IO_LOC "rst_n_in" Y12;
IO_PORT "rst_n_in" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

// LED 状态指示
IO_LOC "led0" P19;
IO_PORT "led0" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "led1" R19;
IO_PORT "led1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// I2S 输出（左侧 PMOD 剩余引脚）
IO_LOC "i2s_bclk" T21;
IO_PORT "i2s_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "i2s_lrclk" U21;
IO_PORT "i2s_lrclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "i2s_data" P16;
IO_PORT "i2s_data" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ================= 板载按键 =================
IO_LOC "key0" AA13;
IO_PORT "key0" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

IO_LOC "key1" AB13;
IO_PORT "key1" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

// ================= 4x4 矩阵键盘（HDMI 附近 PMOD） =================
IO_LOC "key_row[0]" Y21;
IO_PORT "key_row[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "key_row[1]" Y22;
IO_PORT "key_row[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "key_row[2]" AB21;
IO_PORT "key_row[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "key_row[3]" AB22;
IO_PORT "key_row[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "key_col[0]" AA20;
IO_PORT "key_col[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "key_col[1]" AA21;
IO_PORT "key_col[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "key_col[2]" AA19;
IO_PORT "key_col[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "key_col[3]" AB20;
IO_PORT "key_col[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ================= 旋转编码器（左侧 PMOD 剩余） =================
IO_LOC "enc_a" R17;
IO_PORT "enc_a" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "enc_b" R18;
IO_PORT "enc_b" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "enc_sw" T18;
IO_PORT "enc_sw" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;